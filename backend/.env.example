# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:19006,exp://localhost:19000

# Database - Neon/Supabase PostgreSQL (PRODUCTION - never commit real values)
# e.g. postgresql://user:password@ep-xxx.neon.tech/parko?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/parko?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/parko?schema=public

# Auth
JWT_SECRET=change-me-to-32-plus-random-chars
JWT_REFRESH_SECRET=change-me-to-another-32-plus-random-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# App
API_PREFIX=/api
LOG_LEVEL=info
